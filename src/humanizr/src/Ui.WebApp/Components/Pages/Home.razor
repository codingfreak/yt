@page "/"
@using Humanizer
@inject ILogger<Home> Logger;

<PageTitle>Countdown Sample</PageTitle>

<MudContainer>
    <h1>Hello</h1>
    <p>Time until @TargetDate</p>
    <p>@CountdownString</p>
</MudContainer>

@code
{

    private DateTime TargetDate { get; set; } = new(DateTime.Now.Year, 12, 31, 23, 59, 59, 999);

    private Task? _runner;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Logger.LogInformation("Homepage called.");
        _runner = Task.Run(async () =>
        {
            while (true)
            {
                var span = TargetDate - DateTime.Now;
                CountdownString = span.Humanize(precision: 5);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(800);
            }
        });
        base.OnInitialized();
    }

    public string CountdownString { get; set; }
}
